# Telegram Bot (Tạo bot qua @BotFather và lấy chat_id)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Google Sheets (Service Account JSON và tên Spreadsheet)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_NAME=Quản Lý Domain
GOOGLE_RENEWAL_WORKSHEET_NAME=Domain_Renewals

# Cấu hình chu kỳ kiểm tra gia hạn (86400s = 24 giờ)
RENEWAL_CHECK_INTERVAL_SECONDS=86400

# Cấu hình chung
LOG_LEVEL=INFO
